# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.
#
# kernel.type selects the proxy core:
#   auto     (default) — pick per node transport: xray for xhttp/splithttp,
#                        sing-box otherwise. The node switches kernels at runtime
#                        if the transport later crosses that boundary.
#   singbox            — always sing-box (a node whose transport is xhttp/splithttp
#                        is rejected, since sing-box cannot serve it).
#   xray               — always xray (handles every transport).
# kernel.type can only be set at the top level or per instance — NOT per node
# (nodes[].kernel can override config_dir/log_level/etc., but not the kernel type).
# Leave it unset to get "auto".

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1
# kernel:
#   type: auto          # optional; "auto" is the default

# ── Multi-node (one process runs several node IDs on the same panel) ──
# All entries share panel.url and panel.token; panel.node_id is ignored.
# Mutually exclusive with machine mode.
# panel:
#   url: "https://panel.example.com"
#   token: "shared-api-key"       # every node below authenticates with this token
# kernel:
#   type: auto                    # per-node transport picks the kernel
#   config_dir: /etc/xboard-node  # optional; defaults to the config file's directory
# nodes:
#   - node_id: 1
#   - node_id: 2
#   - node_id: 3
#
# With no per-node kernel block, each node gets its own working directory
# derived from the shared one — /etc/xboard-node/node-1, node-2, node-3 — so
# their sing-box cache.db and cert stores never collide. geo_data_dir keeps
# pointing at the shared directory so the geo databases are downloaded once.
#
# A per-node kernel block overrides field by field; anything you leave out keeps
# the top-level value, and config_dir is still auto-derived unless you set it
# explicitly. Note kernel: merges but cert: REPLACES the whole top-level block.
# nodes:
#   - node_id: 1
#   - node_id: 2
#     kernel:
#       log_level: debug                      # config_dir still becomes node-2
#       # config_dir: /srv/node-2             # only if you want a specific path
#     cert:                                   # optional; replaces the top-level
#       cert_mode: file                       # cert block entirely, no merging
#       cert_file: /etc/ssl/node-2.pem
#       key_file: /etc/ssl/node-2.key

# ── Machine mode (one process manages all nodes the panel binds to it) ──
# panel:
#   url: "https://panel.example.com"
# kernel:
#   type: auto          # each discovered node picks its kernel from its transport
# machine:
#   machine_id: 1
#   token: "your-machine-token"
#   # token_env: "MACHINE_TOKEN"   # optional: read token from this env var

# ── Multiple instances (top-level values are the default each instance inherits) ──
# kernel:
#   type: auto          # default for every instance below
# log:
#   level: info
# instances:
#   - panel:                          # inherits kernel.type: auto
#       url: "https://panel-a.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel-b.com"
#       token: "api-key-2"
#       node_id: 2
#     kernel:
#       type: xray                    # pin this instance to xray (overrides top level)
#   - panel:
#       url: "https://panel-c.com"
#     machine:                        # an instance can itself be machine mode
#       machine_id: 5
#       token: "machine-token-c"
#     log:
#       level: debug                  # override for this instance only
